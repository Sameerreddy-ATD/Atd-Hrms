# Copy this file to the repository root as .env.handoff.
# Replace every placeholder. Never commit the resulting .env.handoff file.
HANDOFF_ENV_FILE=.env.handoff

MYSQL_DATABASE=anytimediesel_hrms
MYSQL_USER=atd_hrms
MYSQL_PASSWORD=replace-with-a-local-compose-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
DATABASE_URL=mysql://atd_hrms:URL_ENCODED_PASSWORD@mysql:3306/anytimediesel_hrms

BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:8080
VITE_API_BASE_URL=/api
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_API_TIMEOUT_MS=20000
TRUST_PROXY=1

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
EMPLOYEE_DATA_ENCRYPTION_KEY=replace-with-a-stable-32-character-encryption-key
SESSION_COOKIE_NAME=adh_session
REFRESH_COOKIE_NAME=adh_refresh
COOKIE_SECURE=false
NODE_ENV=development

GENERAL_RATE_LIMIT_MAX=12000
GENERAL_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=50
AUTH_RATE_LIMIT_WINDOW_MS=900000
REQUEST_TIMEOUT_MS=30000

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hrms@example.com
HTTP_PORT=8080
