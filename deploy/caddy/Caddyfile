# Reference Caddyfile for production (hrms.anytime-diesel.com).
# Live copy: /etc/caddy/Caddyfile on the Lightsail host.
#
# Maintenance mode (Caddy 2.11-compatible):
#   scripts/maintenance.sh writes/removes
#   /opt/anytime-crew-hub/shared/caddy/50-maintenance.conf
#   and reloads Caddy. Backend also reads shared/maintenance.json.
#
# /api/v1 keeps its prefix. Other /api/* paths use handle_path (strip /api).

insidesales.anytime-diesel.com {
	encode gzip
	reverse_proxy 127.0.0.1:8088
}

hrms.anytime-diesel.com {
	encode gzip
	request_body {
		max_size 20MB
	}

	@healthApi path /api/health /api/health/* /api/maintenance/status
	handle @healthApi {
		handle_path /api/* {
			reverse_proxy 127.0.0.1:4000
		}
	}

	handle /maintenance.html {
		root * /opt/anytime-crew-hub/public
		header Cache-Control "no-store"
		file_server
	}

	@versionMeta path /app-version.json /sw.js /manifest.webmanifest
	handle @versionMeta {
		reverse_proxy 127.0.0.1:8081 {
			header_down Cache-Control "no-store"
			header_down Strict-Transport-Security "max-age=31536000; includeSubDomains"
			header_down X-Content-Type-Options "nosniff"
			header_down -Server
		}
	}

	import /opt/anytime-crew-hub/shared/caddy/*.conf

	@apiv1 path /api/v1 /api/v1/*
	handle @apiv1 {
		reverse_proxy 127.0.0.1:4000
	}

	handle_path /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	@hashed path /assets/*
	handle @hashed {
		reverse_proxy 127.0.0.1:8081 {
			header_down Cache-Control "public, max-age=31536000, immutable"
			header_down Strict-Transport-Security "max-age=31536000; includeSubDomains"
			header_down X-Content-Type-Options "nosniff"
			header_down -Server
		}
	}

	@models path /face-models/*
	handle @models {
		reverse_proxy 127.0.0.1:8081 {
			header_down Cache-Control "public, max-age=604800"
			header_down Strict-Transport-Security "max-age=31536000; includeSubDomains"
			header_down X-Content-Type-Options "nosniff"
			header_down -Server
		}
	}

	handle {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
			-Server
		}
		reverse_proxy 127.0.0.1:8081
	}
}
