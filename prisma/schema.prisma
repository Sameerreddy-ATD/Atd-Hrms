  certificateRequests         CertificateRequest[]
  attendanceReminders         AttendanceReminder[]
  changeEvents                EmployeeChangeEvent[]
  faceEvidence                FaceEvidence[]
  rosterAssignments           RosterAssignment[]
  overtimeClaims              OvertimeClaim[]
  checklistInstances          ChecklistInstance[]
  documentAcks                DocumentAck[]
  sopReads                    SopRead[]
  appraisalReviews            AppraisalReview[]
  candidatesHired             Candidate[]                      @relation("HiredEmployee")
  shiftAssignments            EmployeeShiftAssignment[]
  shiftDayOverrides           EmployeeShiftDayOverride[]
  leaveLedgerEntries          LeaveLedgerEntry[]
  onboardingCases             OnboardingCase[]
  nhoProfile                  NewHireProfile?
  compensationRecords         EmployeeCompensation[]
