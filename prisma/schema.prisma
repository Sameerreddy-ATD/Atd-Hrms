model ShiftDefinition {
  shiftId             String                     @id @default(cuid()) @map("shift_id")
  name                String                     @unique
  code                String                     @unique
  shiftType           ShiftType                  @default(DAY) @map("shift_type")
  /// Legacy single-window snapshot (first segment) for Android / attendancePolicy compatibility.
  startMinutes        Int                        @map("start_minutes")
  endMinutes          Int                        @map("end_minutes")
  active              Boolean                    @default(true)
  description         String?                    @db.Text
  timezone            String                     @default("Asia/Kolkata") @db.VarChar(64)
  graceInMinutes      Int                        @default(30) @map("grace_in_minutes")
  graceOutMinutes     Int                        @default(30) @map("grace_out_minutes")
  expectedWorkMinutes Int                        @default(0) @map("expected_work_minutes")
  colorToken          String?                    @map("color_token") @db.VarChar(40)
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  assignments         EmployeeShiftAssignment[]
  segments            ShiftSegment[]
  rosterAssignments   RosterAssignment[]
  dayOverrides        EmployeeShiftDayOverride[]
  attendanceWorkdays  AttendanceWorkday[]

  @@map("shift_definitions")
}

/// Ordered work segments for a ShiftDefinition (Shift Template).
/// endDayOffset: 0 = same Work Date calendar day, 1 = next calendar day.
model ShiftSegment {
  id           String          @id @default(cuid())
  shiftId      String          @map("shift_id")
  shift        ShiftDefinition @relation(fields: [shiftId], references: [shiftId], onDelete: Cascade)
  sequence     Int             @default(1)
  startMinute  Int             @map("start_minute")
  endMinute    Int             @map("end_minute")
  endDayOffset Int             @default(0) @map("end_day_offset")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([shiftId, sequence])
  @@index([shiftId])
  @@map("shift_segments")
}

model EmployeeShiftAssignment {
  assignmentId   String          @id @default(cuid()) @map("assignment_id")
  employeeId     String          @map("employee_id")
  employee       Employee        @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  shiftId        String          @map("shift_id")
  shift          ShiftDefinition @relation(fields: [shiftId], references: [shiftId], onDelete: Restrict)
  /// DEFAULT (canonical employee default). Future types may be added.
  assignmentType String          @default("DEFAULT") @map("assignment_type") @db.VarChar(30)
  effectiveFrom  DateTime        @map("effective_from") @db.Date
  effectiveTo    DateTime?       @map("effective_to") @db.Date
  assignedBy     String?         @map("assigned_by")
  reason         String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, assignmentType, effectiveFrom, effectiveTo], map: "esa_employee_type_effective_idx")
  @@index([shiftId])
  @@map("employee_shift_assignments")
}

model Department {
  departmentId            String                           @id @default(cuid()) @map("department_id")
  name                    String
  /// Stable identifier for authorization and integrations; display name may change.
  unitCode                String                           @unique @map("unit_code") @db.VarChar(60)
  description             String?                          @db.Text
  active                  Boolean                          @default(true)
  /// Primary / first head (kept in sync with active primary head assignment).
  headEmployeeId          String?                          @map("head_employee_id")
  headEmployee            Employee?                        @relation("DepartmentHead", fields: [headEmployeeId], references: [employeeId])
  headAssignments         DepartmentHeadAssignment[]
  viewerAssignments       DepartmentViewerAssignment[]
  parentDepartmentId      String?                          @map("parent_department_id")
  parentDepartment        Department?                      @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [departmentId])
  childDepartments        Department[]                     @relation("DepartmentHierarchy")
  unitType                String                           @default("TEAM") @map("unit_type") @db.VarChar(20)
  sortOrder               Int                              @default(0) @map("sort_order")
  /// When false, people in this unit skip face enrollment and check-in camera.
  /// Global Face Security pause still wins for the whole org.
  faceVerificationEnabled Boolean                          @default(true) @map("face_verification_enabled")
  createdAt               DateTime                         @default(now()) @map("created_at")
  updatedAt               DateTime                         @updatedAt @map("updated_at")
  employees               Employee[]
  employeeOrgAssignments  EmployeeOrganizationAssignment[]
  taskBoardAccess         TaskBoardDepartment[]

  @@index([parentDepartmentId])
  @@index([name])
  @@index([active])
  @@map("departments")
}

/**
 * Historical organization head assignments. Active rows have effectiveTo = null.
 * effectiveFrom is inclusive; effectiveTo is exclusive (assignment ends at start of that date).
 */
model DepartmentHeadAssignment {
  id               String     @id @default(cuid())
  departmentId     String     @map("department_id")
  department       Department @relation(fields: [departmentId], references: [departmentId], onDelete: Cascade)
  employeeId       String     @map("employee_id")
  employee         Employee   @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  isPrimary        Boolean    @default(false) @map("is_primary")
  effectiveFrom    DateTime   @map("effective_from") @db.Date
  effectiveTo      DateTime?  @map("effective_to") @db.Date
  assignedByUserId String?    @map("assigned_by_user_id")
  reason           String?    @db.Text
  sortOrder        Int        @default(0) @map("sort_order")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([departmentId, effectiveFrom, effectiveTo], map: "dha_dept_effective_idx")
  @@index([employeeId, effectiveFrom, effectiveTo], map: "dha_employee_effective_idx")
  @@map("department_head_assignments")
}

/**
 * Historical view-only access to a unit and its descendants.
 * Does not grant leave/punch approval.
 */
model DepartmentViewerAssignment {
  id               String     @id @default(cuid())
  departmentId     String     @map("department_id")
  department       Department @relation(fields: [departmentId], references: [departmentId], onDelete: Cascade)
  employeeId       String     @map("employee_id")
  employee         Employee   @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  effectiveFrom    DateTime   @map("effective_from") @db.Date
  effectiveTo      DateTime?  @map("effective_to") @db.Date
  assignedByUserId String?    @map("assigned_by_user_id")
  reason           String?    @db.Text
  sortOrder        Int        @default(0) @map("sort_order")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([departmentId, effectiveFrom, effectiveTo], map: "dva_dept_effective_idx")
  @@index([employeeId, effectiveFrom, effectiveTo], map: "dva_employee_effective_idx")
  @@map("department_viewer_assignments")
}

/**
 * Canonical history of which organization unit an employee belonged to.
 * Employee.departmentId remains the current primary snapshot for compatibility.
 */
model EmployeeOrganizationAssignment {
  id                String     @id @default(cuid())
  employeeId        String     @map("employee_id")
  employee          Employee   @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  departmentId      String     @map("department_id")
  department        Department @relation(fields: [departmentId], references: [departmentId], onDelete: Restrict)
  organizationLevel String     @default("MEMBER") @map("organization_level") @db.VarChar(20)
  isPrimary         Boolean    @default(true) @map("is_primary")
  effectiveFrom     DateTime   @map("effective_from") @db.Date
  effectiveTo       DateTime?  @map("effective_to") @db.Date
  changedByUserId   String?    @map("changed_by_user_id")
  reason            String?    @db.Text
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@index([employeeId, isPrimary, effectiveFrom, effectiveTo], map: "eoa_employee_primary_idx")
  @@index([departmentId, effectiveFrom, effectiveTo], map: "eoa_dept_effective_idx")
  @@map("employee_organization_assignments")
