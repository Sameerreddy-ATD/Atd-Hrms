  name                        String
  email                       String?                          @unique
  personalEmail               String?                          @map("personal_email")
  phone                       String?
  companyPhone                String?                          @map("company_phone")
  companyEntity               CompanyEntity                    @default(ANYTIME_DIESEL) @map("company_entity")
  departmentId                String?                          @map("department_id")
  department                  Department?                      @relation(fields: [departmentId], references: [departmentId])
  designation                 String?
  homeBranchId                String?                          @map("home_branch_id")
  homeBranch                  Branch?                          @relation(fields: [homeBranchId], references: [branchId])
  managerId                   String?                          @map("manager_id")
  manager                     Employee?                        @relation("ManagerTeam", fields: [managerId], references: [employeeId])
  teamMembers                 Employee[]                       @relation("ManagerTeam")
  joiningDate                 DateTime?                        @map("joining_date") @db.Date
  dateOfBirth                 DateTime?                        @map("date_of_birth") @db.Date
  gender                      Gender?
  bloodGroup                  String?                          @map("blood_group")
  employmentType              EmploymentType?                  @map("employment_type")
  organizationLevel           String                           @default("MEMBER") @map("organization_level") @db.VarChar(20)
  bankAccountType             BankAccountType?                 @map("bank_account_type")
  bankAccountHolderName       String?                          @map("bank_account_holder_name")
  bankIfscCode                String?                          @map("bank_ifsc_code")
  bankAccountNumberEncrypted  String?                          @map("bank_account_number_encrypted") @db.Text
  bankAccountNumberLast4      String?                          @map("bank_account_number_last4") @db.VarChar(4)
  panNumberEncrypted          String?                          @map("pan_number_encrypted") @db.Text
  panNumberLast4              String?                          @map("pan_number_last4") @db.VarChar(4)
  aadhaarNumberEncrypted      String?                          @map("aadhaar_number_encrypted") @db.Text
  aadhaarNumberLast4          String?                          @map("aadhaar_number_last4") @db.VarChar(4)
  uanNumberEncrypted          String?                          @map("uan_number_encrypted") @db.Text
  uanNumberLast4              String?                          @map("uan_number_last4") @db.VarChar(4)
  fatherName                  String?                          @map("father_name")
  husbandName                 String?                          @map("husband_name")
  maritalStatus               MaritalStatus?                   @map("marital_status")
  presentDoorNo               String?                          @map("present_door_no")
  presentFlatName             String?                          @map("present_flat_name")
  presentStreetName           String?                          @map("present_street_name")
  presentAddress              String?                          @map("present_address") @db.Text
  presentCity                 String?                          @map("present_city")
  presentState                String?                          @map("present_state")
  presentPincode              String?                          @map("present_pincode") @db.VarChar(12)
  permanentDoorNo             String?                          @map("permanent_door_no")
  permanentFlatName           String?                          @map("permanent_flat_name")
  permanentStreetName         String?                          @map("permanent_street_name")
  permanentSameAsPresent      Boolean                          @default(false) @map("permanent_same_as_present")
  permanentAddress            String?                          @map("permanent_address") @db.Text
  permanentCity               String?                          @map("permanent_city")
  permanentState              String?                          @map("permanent_state")
  permanentPincode            String?                          @map("permanent_pincode") @db.VarChar(12)
  /// APPLIED | INTERVIEW | OFFER | PRE_ONBOARDING | ONBOARDING | NHO | ACTIVE | NOTICE | OFFBOARDING | EXITED
