  documents       OnboardingDocument[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@map("onboarding_cases")
}

model OnboardingDocument {
  documentId       String         @id @default(cuid()) @map("document_id")
  caseId           String         @map("case_id")
  case             OnboardingCase @relation(fields: [caseId], references: [caseId], onDelete: Cascade)
  /// OFFER_LETTER | NDA | AADHAAR | PAN | HANDBOOK
  docType          String         @map("doc_type") @db.VarChar(24)
  /// PENDING | SENT | UPLOADED | SIGNED | VERIFIED | REJECTED
  status           String         @default("PENDING")
  fileName         String?        @map("file_name")
  storageKey       String?        @map("storage_key")
  employeeNotes    String?        @map("employee_notes") @db.Text
  verifiedByUserId String?        @map("verified_by_user_id")
  verifiedAt       DateTime?      @map("verified_at")
  signedAt         DateTime?      @map("signed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([caseId, docType])
  @@map("onboarding_documents")
}

model NewHireProfile {
  profileId        String    @id @default(cuid()) @map("profile_id")
  employeeId       String    @unique @map("employee_id")
  employee         Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  fullName         String?   @map("full_name")
  fatherName       String?   @map("father_name")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  ageYears         Int?      @map("age_years")
  gender           String?
  presentAddress   String?   @map("present_address") @db.Text
  presentCity      String?   @map("present_city")
  presentState     String?   @map("present_state")
  presentPincode   String?   @map("present_pincode") @db.VarChar(12)
  permanentAddress String?   @map("permanent_address") @db.Text
  permanentCity    String?   @map("permanent_city")
  permanentState   String?   @map("permanent_state")
  permanentPincode String?   @map("permanent_pincode") @db.VarChar(12)
  panNumber        String?   @map("pan_number")
  aadhaarLast4     String?   @map("aadhaar_last4") @db.VarChar(4)
  /// DRAFT | SUBMITTED | HR_VERIFIED | REJECTED
  status           String    @default("DRAFT")
  submittedAt      DateTime? @map("submitted_at")
  verifiedAt       DateTime? @map("verified_at")
  verifiedByUserId String?   @map("verified_by_user_id")
  hrNotes          String?   @map("hr_notes") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("new_hire_profiles")
}

model EmployeeCompensation {
  compensationId  String   @id @default(cuid()) @map("compensation_id")
  employeeId      String   @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  effectiveFrom   DateTime @map("effective_from") @db.Date
  ctcAnnual       Decimal  @map("ctc_annual") @db.Decimal(12, 2)
  basicMonthly    Decimal? @map("basic_monthly") @db.Decimal(12, 2)
  notes           String?  @db.Text
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([employeeId, effectiveFrom])
  @@map("employee_compensation")
}

model RecurringAllowance {
  allowanceId     String    @id @default(cuid()) @map("allowance_id")
  employeeId      String    @map("employee_id")
  employee        Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  name            String
  amountMonthly   Decimal   @map("amount_monthly") @db.Decimal(12, 2)
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  /// ACTIVE | ENDED
  status          String    @default("ACTIVE")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@map("recurring_allowances")
}

model OneTimePayment {
  paymentId       String   @id @default(cuid()) @map("payment_id")
  employeeId      String   @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  name            String
  amount          Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime @map("payment_date") @db.Date
  reason          String?  @db.Text
  /// PENDING | APPROVED | PAID | CANCELLED
  status          String   @default("PENDING")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([employeeId, paymentDate])
  @@map("one_time_payments")
}

model ShiftSwapRequest {
  swapId                String    @id @default(cuid()) @map("swap_id")
  employeeId            String    @map("employee_id")
  employee              Employee  @relation("SwapRequester", fields: [employeeId], references: [employeeId], onDelete: Cascade)
  counterpartEmployeeId String    @map("counterpart_employee_id")
  counterpart           Employee  @relation("SwapCounterpart", fields: [counterpartEmployeeId], references: [employeeId], onDelete: Cascade)
  workDate              DateTime  @map("work_date") @db.Date
  reason                String?   @db.Text
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status                String    @default("PENDING")
  reviewedByUserId      String?   @map("reviewed_by_user_id")
  reviewedAt            DateTime? @map("reviewed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([employeeId, workDate])
  @@index([counterpartEmployeeId, workDate])
  @@map("shift_swap_requests")
}

model EmployeeChangeRequest {
  changeId            String    @id @default(cuid()) @map("change_id")
  employeeId          String    @map("employee_id")
  employee            Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  /// SHIFT_CHANGE | SHIFT_SWAP | PROMOTION | DEPARTMENT_CHANGE | EMPLOYMENT_TYPE_CHANGE | SALARY_CHANGE | DESIGNATION_CHANGE | BRANCH_CHANGE | ADDRESS_CHANGE | MANAGER_CHANGE | HIERARCHY_CHANGE | RECURRING_ALLOWANCE | ONE_TIME_PAYMENT
  kind                String    @db.VarChar(40)
  effectiveDate       DateTime  @map("effective_date") @db.Date
  payload             Json
  reason              String?   @db.Text
  hrLetterFileName    String?   @map("hr_letter_file_name")
  hrLetterStorageKey  String?   @map("hr_letter_storage_key")
  /// DRAFT | PENDING_MANAGER | PENDING_HR | APPROVED | REJECTED | APPLIED
  status              String    @default("PENDING_HR")
  requestedByUserId   String    @map("requested_by_user_id")
  managerApprovedById String?   @map("manager_approved_by_id")
  managerApprovedAt   DateTime? @map("manager_approved_at")
  hrApprovedById      String?   @map("hr_approved_by_id")
  hrApprovedAt        DateTime? @map("hr_approved_at")
  appliedAt           DateTime? @map("applied_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@index([kind, status])
  @@map("employee_change_requests")
}

model OffboardingCase {
  caseId                String    @id @default(cuid()) @map("case_id")
  employeeId            String    @map("employee_id")
  employee              Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  /// RESIGNATION | TERMINATION | INTERN_COMPLETE | ABSCONDING
  reason                String    @db.VarChar(24)
  endDate               DateTime  @map("end_date") @db.Date
  /// OPEN | ACCESS_REMOVED | ASSETS_CLEARED | NO_DUES | LETTERS_ISSUED | CLOSED
  status                String    @default("OPEN")
  accessRemovedAt       DateTime? @map("access_removed_at")
  assetsClearedAt       DateTime? @map("assets_cleared_at")
  noDuesAt              DateTime? @map("no_dues_at")
  resignationLetterKey  String?   @map("resignation_letter_key")
  resignationLetterName String?   @map("resignation_letter_name")
  experienceLetterKey   String?   @map("experience_letter_key")
  experienceLetterName  String?   @map("experience_letter_name")
  internCertificateKey  String?   @map("intern_certificate_key")
  internCertificateName String?   @map("intern_certificate_name")
  notes                 String?   @db.Text
  startedByUserId       String    @map("started_by_user_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([employeeId, status])
  @@map("offboarding_cases")
}

model DeferredPunchReceipt {
  receiptId  String   @id @default(cuid()) @map("receipt_id")
  employeeId String   @map("employee_id")
  nonce      String   @unique
  kind       String
  capturedAt DateTime @map("captured_at")
  syncedAt   DateTime @default(now()) @map("synced_at")

  @@index([employeeId, capturedAt])
  @@map("deferred_punch_receipts")
}

model ProfileCorrectionRequest {
  id             String    @id @default(cuid())
  employeeId     String    @map("employee_id")
  employee       Employee  @relation(fields: [employeeId], references: [employeeId])
  field          String    @db.VarChar(60)
  section        String    @db.VarChar(20)
  currentValue   String?   @map("current_value") @db.Text
  suggestedValue String    @map("suggested_value") @db.Text
  status         String    @default("PENDING") @db.VarChar(20)
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([employeeId, status])
  @@map("profile_correction_requests")
}
