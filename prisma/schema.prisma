  @@map("task_workflow_type_mappings")
}

model TaskWorkflowStatus {
  statusId        String                   @id @default(cuid()) @map("status_id")
  workflowId      String                   @map("workflow_id")
  workflow        TaskWorkflow             @relation(fields: [workflowId], references: [workflowId], onDelete: Cascade)
  name            String
  category        TaskStatusCategory
  sortOrder       Int                      @default(0) @map("sort_order")
  color           String                   @default("SLATE")
  isInitial       Boolean                  @default(false) @map("is_initial")
  isTerminal      Boolean                  @default(false) @map("is_terminal")
  active          Boolean                  @default(true)
  /// Board column this status appears in (Board Column → Workflow Status).
  stageId         String?                  @map("stage_id")
  stage           TaskStage?               @relation(fields: [stageId], references: [stageId], onDelete: SetNull)
  workItems       WorkTask[]
  fromTransitions TaskWorkflowTransition[] @relation("TransitionFrom")
  toTransitions   TaskWorkflowTransition[] @relation("TransitionTo")
