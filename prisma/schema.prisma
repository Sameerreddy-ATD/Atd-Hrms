model WorkTask {
  taskId            String                  @id @default(cuid()) @map("task_id")
  title             String
  description       String?                 @db.Text
  createdByUserId   String                  @map("created_by_user_id")
  createdBy         User                    @relation("TaskCreator", fields: [createdByUserId], references: [id])
  /// Reporter is distinct from creator; defaults to creator on create when omitted.
  reporterUserId    String?                 @map("reporter_user_id")
  reporter          User?                   @relation("TaskReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  parentTaskId      String?                 @map("parent_task_id")
  parentTask        WorkTask?               @relation("TaskHierarchy", fields: [parentTaskId], references: [taskId])
  subtasks          WorkTask[]              @relation("TaskHierarchy")
  boardId           String?                 @map("board_id")
  board             TaskBoard?              @relation(fields: [boardId], references: [boardId], onDelete: SetNull)
  stageId           String?                 @map("stage_id")
  stage             TaskStage?              @relation(fields: [stageId], references: [stageId], onDelete: SetNull)
  issueNumber       Int?                    @map("issue_number")
  issueKey          String?                 @unique @map("issue_key") @db.VarChar(32)
  issueType         TaskIssueType           @default(TASK) @map("issue_type")
  rank              Float                   @default(0) @map("rank")
  status            TaskStatus              @default(TODO)
  priority          TaskPriority            @default(MEDIUM)
  progress          Int                     @default(0)
  version           Int                     @default(1)
  startDate         DateTime?               @map("start_date") @db.Date
  dueDate           DateTime?               @map("due_date") @db.Date
  completedAt       DateTime?               @map("completed_at")
  archivedAt        DateTime?               @map("archived_at")
  customFields      Json?                   @map("custom_fields")
  /// Workflow engine status (authoritative). Stage remains the board column.
  workflowStatusId  String?                 @map("workflow_status_id")
  workflowStatus    TaskWorkflowStatus?     @relation(fields: [workflowStatusId], references: [statusId], onDelete: SetNull)
  /// Simple required-field target (e.g. resolution on Done/Closed).
  resolution        String?                 @db.VarChar(120)
  lastActivityAt    DateTime                @default(now()) @map("last_activity_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  updates           TaskUpdate[]
  assignments       TaskAssignment[]
  attachments       TaskAttachment[]
  transitionHistory TaskTransitionHistory[]

  @@unique([boardId, issueNumber])
  @@index([status])
  @@index([createdByUserId])
  @@index([reporterUserId])
  @@index([dueDate])
  @@index([boardId, stageId])
  @@index([boardId, stageId, rank])
  @@index([boardId, status, dueDate])
  @@index([archivedAt, status])
  @@index([lastActivityAt])
  @@index([parentTaskId])
  @@index([issueType])
  @@index([workflowStatusId])
  @@map("work_tasks")
}

