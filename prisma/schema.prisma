  ATTENDANCE_CHECK_IN
  ATTENDANCE_CHECK_OUT
}

enum FaceVerificationOutcome {
  CREATED
  PASSED
  FAILED
  EXPIRED
}

enum WeeklyOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveStatus {
  PENDING
  MANAGER_APPROVED
  HR_VERIFIED
  APPROVED
  REJECTED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskIssueType {
  TASK
  BUG
  STORY
  EPIC
}

enum TaskActivityType {
  CREATED
  COMMENT
  STATUS_CHANGED
  PROGRESS_UPDATED
  ASSIGNEES_CHANGED
  DETAILS_UPDATED
}

enum TaskBoardAccessType {
  OPEN
  DEPARTMENT_GATED
  MEMBER_GATED
}

enum AssetType {
  PHYSICAL
  ONLINE
}

enum AssetAssignmentScope {
  EMPLOYEE
  COMPANY
}

enum AssetCostFrequency {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum IntegrationClientStatus {
  ACTIVE
  REVOKED
}

enum EmployeeChangeType {
  CREATED
  UPDATED
  DEACTIVATED
  REACTIVATED
}

model User {
  id                               String                    @id @default(cuid())
  employeeId                       String?                   @unique @map("employee_id")
  employee                         Employee?                 @relation(fields: [employeeId], references: [employeeId])
  name                             String
  email                            String                    @unique
  phone                            String?                   @unique
  passwordHash                     String                    @map("password_hash")
  role                             Role
  status                           UserStatus                @default(ACTIVE)
  firstLoginPasswordChangeRequired Boolean                   @default(true) @map("first_login_password_change_required")
  failedLoginAttempts              Int                       @default(0) @map("failed_login_attempts")
  sessionVersion                   Int                       @default(0) @map("session_version")
  lastLoginAt                      DateTime?                 @map("last_login_at")
  createdByUserId                  String?                   @map("created_by_user_id")
  createdAt                        DateTime                  @default(now()) @map("created_at")
  updatedAt                        DateTime                  @updatedAt @map("updated_at")
  suspendedUntil                   DateTime?                 @map("suspended_until")
  suspensionStartsAt               DateTime?                 @map("suspension_starts_at")
  deactivatedAt                    DateTime?                 @map("deactivated_at")
  createdUsers                     User[]                    @relation("CreatedUsers")
  creator                          User?                     @relation("CreatedUsers", fields: [createdByUserId], references: [id])
  performedAuditLogs               AuditLog[]                @relation("AuditPerformedBy")
  affectedAuditLogs                AuditLog[]                @relation("AuditAffectedUser")
  createdTasks                     WorkTask[]                @relation("TaskCreator")
  createdTaskBoards                TaskBoard[]               @relation("TaskBoardCreator")
  taskUpdates                      TaskUpdate[]
  taskAssignmentsMade              TaskAssignment[]          @relation("TaskAssignedBy")
  announcements                    Announcement[]            @relation("AnnouncementAuthor")
  pushSubscriptions                PushSubscription[]
  privateFiles                     PrivateFile[]             @relation("PrivateFileUploader")
  reviewedExpenseClaims            ExpenseClaim[]            @relation("ExpenseReviewer")
  reviewedDocumentRequests         CertificateRequest[]      @relation("DocumentReviewer")
  reviewedLeaveRequests            LeaveRequest[]            @relation("LeaveReviewer")
  createdIntegrationClients        IntegrationClient[]       @relation("IntegrationClientCreator")
  faceProfile                      FaceProfile?              @relation("FaceProfileOwner")
  approvedFaceProfiles             FaceProfile[]             @relation("FaceProfileApprover")
  faceVerificationSessions         FaceVerificationSession[]
  faceEvidence                     FaceEvidence[]
  taskAttachments                  TaskAttachment[]
  notificationPreference           NotificationPreference?
  reviewedOvertimeClaims           OvertimeClaim[]           @relation("OvertimeReviewer")
  uploadedDocuments                CompanyDocument[]         @relation("DocumentUploader")
  authoredSopArticles              SopArticle[]              @relation("SopAuthor")
  appraisalReviewsAsManager        AppraisalReview[]         @relation("AppraisalManager")
  createdRecruitmentJobs           RecruitmentJob[]          @relation("JobCreator")
  sessions                         UserSession[]

  @@index([status, role])
  @@map("users")
}

/// One row per signed-in device. Sessions coexist so an employee can stay signed
/// in on the phone app and the web dashboard at once, and Developer Admin can
/// see and revoke individual devices. `User.sessionVersion` remains the
/// account-wide kill switch for password changes and status changes.
model UserSession {
  sessionId      String    @id @default(cuid()) @map("session_id")
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The account-wide version this device was issued against. Any bump of
  /// User.sessionVersion (password change, deactivation, suspension, role
  /// change) leaves this behind, which retires the row without each of those
  /// call sites having to know about the session table.
  sessionVersion Int       @map("session_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  /// Why the session ended, for the admin device list: LOGOUT | PASSWORD_CHANGE |
  /// ADMIN_REVOKED | ACCOUNT_STATUS.
  revokedReason  String?   @map("revoked_reason") @db.VarChar(32)
  ipAddress      String?   @map("ip_address") @db.VarChar(64)
  userAgent      String?   @map("user_agent") @db.VarChar(400)
  /// Coarse client label derived from the user agent: Android app, iPhone, Web.
  platform       String?   @db.VarChar(40)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PrivateFile {
  fileId           String   @id @default(cuid()) @map("file_id")
  storageKey       String   @unique @map("storage_key") @db.VarChar(255)
  /// medical | receipt
  kind             String   @db.VarChar(16)
  uploadedByUserId String   @map("uploaded_by_user_id")
  uploadedBy       User     @relation("PrivateFileUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  mimeType         String   @map("mime_type") @db.VarChar(120)
  sizeBytes        Int      @map("size_bytes")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([uploadedByUserId, kind])
  @@map("private_files")
}

model Announcement {
  announcementId String    @id @default(cuid()) @map("announcement_id")
  title          String
  message        String    @db.Text
  priority       String    @default("NORMAL")
  publishAt      DateTime  @default(now()) @map("publish_at")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  createdById    String    @map("created_by_id")
  createdBy      User      @relation("AnnouncementAuthor", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([isActive, publishAt, expiresAt])
  @@map("announcements")
}

model PushSubscription {
  subscriptionId String   @id @default(cuid()) @map("subscription_id")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// web | fcm | apns
  channel        String   @default("web") @db.VarChar(16)
  endpoint       String   @db.Text
  endpointHash   String   @unique @map("endpoint_hash") @db.VarChar(64)
  p256dh         String   @db.Text
  auth           String   @db.Text
  userAgent      String?  @map("user_agent") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([channel])
  @@map("push_subscriptions")
}

model Employee {
  employeeId                 String                        @id @default(cuid()) @map("employee_id")
  employeeCode               String                        @unique @map("employee_code")
  externalReference          String?                       @unique @map("external_reference")
  name                       String
  email                      String?                       @unique
  phone                      String?
  companyPhone               String?                       @map("company_phone")
  companyEntity              CompanyEntity                 @default(ANYTIME_DIESEL) @map("company_entity")
  departmentId               String?                       @map("department_id")
  department                 Department?                   @relation(fields: [departmentId], references: [departmentId])
  designation                String?
  homeBranchId               String?                       @map("home_branch_id")
  homeBranch                 Branch?                       @relation(fields: [homeBranchId], references: [branchId])
  managerId                  String?                       @map("manager_id")
  manager                    Employee?                     @relation("ManagerTeam", fields: [managerId], references: [employeeId])
  teamMembers                Employee[]                    @relation("ManagerTeam")
  joiningDate                DateTime?                     @map("joining_date") @db.Date
  dateOfBirth                DateTime?                     @map("date_of_birth") @db.Date
  gender                     Gender?
  bloodGroup                 String?                       @map("blood_group")
  employmentType             EmploymentType?               @map("employment_type")
  organizationLevel          String                        @default("MEMBER") @map("organization_level") @db.VarChar(20)
  bankAccountType            BankAccountType?              @map("bank_account_type")
  bankAccountHolderName      String?                       @map("bank_account_holder_name")
  bankIfscCode               String?                       @map("bank_ifsc_code")
  bankAccountNumberEncrypted String?                       @map("bank_account_number_encrypted") @db.Text
  bankAccountNumberLast4     String?                       @map("bank_account_number_last4") @db.VarChar(4)
  panNumberEncrypted         String?                       @map("pan_number_encrypted") @db.Text
  panNumberLast4             String?                       @map("pan_number_last4") @db.VarChar(4)
  aadhaarNumberEncrypted     String?                       @map("aadhaar_number_encrypted") @db.Text
  aadhaarNumberLast4         String?                       @map("aadhaar_number_last4") @db.VarChar(4)
  uanNumberEncrypted         String?                       @map("uan_number_encrypted") @db.Text
  uanNumberLast4             String?                       @map("uan_number_last4") @db.VarChar(4)
  fatherName                 String?                       @map("father_name")
  presentAddress             String?                       @map("present_address") @db.Text
  presentCity                String?                       @map("present_city")
  presentState               String?                       @map("present_state")
  presentPincode             String?                       @map("present_pincode") @db.VarChar(12)
  permanentAddress           String?                       @map("permanent_address") @db.Text
  permanentCity              String?                       @map("permanent_city")
  permanentState             String?                       @map("permanent_state")
  permanentPincode           String?                       @map("permanent_pincode") @db.VarChar(12)
  /// APPLIED | INTERVIEW | OFFER | PRE_ONBOARDING | ONBOARDING | NHO | ACTIVE | NOTICE | OFFBOARDING | EXITED
  lifecycleStage             String                        @default("ACTIVE") @map("lifecycle_stage") @db.VarChar(24)
  attendanceMode             AttendanceMode                @default(BOTH) @map("attendance_mode")
  attendanceRequired         Boolean                       @default(true) @map("attendance_required")
  shiftType                  ShiftType                     @default(DAY) @map("shift_type")
  shiftStartMinutes          Int                           @default(540) @map("shift_start_minutes")
  shiftEndMinutes            Int                           @default(1080) @map("shift_end_minutes")
  isFieldEmployee            Boolean                       @default(false) @map("is_field_employee")
  weeklyOffPolicy            WeeklyOffPolicy               @default(SELECTABLE) @map("weekly_off_policy")
  status                     EmployeeStatus                @default(ACTIVE)
  version                    Int                           @default(1)
  terminatedAt               DateTime?                     @map("terminated_at")
  createdAt                  DateTime                      @default(now()) @map("created_at")
  updatedAt                  DateTime                      @updatedAt @map("updated_at")
  user                       User?
  schedules                  EmployeeBranchSchedule[]
  attendanceEvents           AttendanceEvent[]
  summaries                  AttendanceDailySummary[]
  fieldAttendances           FieldAttendance[]
  biometricMappings          BiometricEmployeeMapping[]
  leaveRequests              LeaveRequest[]
  leaveBalances              LeaveBalance[]
  weeklyOffRequests          WeeklyOffRequest[]
  compOffCredits             CompOffCredit[]
  correctionRequests         AttendanceCorrectionRequest[]
  emergencyContact           EmergencyContact?
  headedDepartments          Department[]                  @relation("DepartmentHead")
  departmentHeadAssignments  DepartmentHeadAssignment[]
  assignedAssets             CompanyAsset[]
  assetAssignments           AssetAssignment[]
  taskAssignments            TaskAssignment[]
  taskBoardMemberships       TaskBoardMember[]
  assetReturns               AssetReturn[]
  expenseClaims              ExpenseClaim[]
  certificateRequests        CertificateRequest[]
  attendanceReminders        AttendanceReminder[]
  changeEvents               EmployeeChangeEvent[]
  faceEvidence               FaceEvidence[]
  rosterAssignments          RosterAssignment[]
  overtimeClaims             OvertimeClaim[]
  checklistInstances         ChecklistInstance[]
  documentAcks               DocumentAck[]
  sopReads                   SopRead[]
  appraisalReviews           AppraisalReview[]
  candidatesHired            Candidate[]                   @relation("HiredEmployee")
  shiftAssignments           EmployeeShiftAssignment[]
  leaveLedgerEntries         LeaveLedgerEntry[]
  onboardingCases            OnboardingCase[]
  nhoProfile                 NewHireProfile?
  compensationRecords        EmployeeCompensation[]
  recurringAllowances        RecurringAllowance[]
  oneTimePayments            OneTimePayment[]
  shiftSwapsRequested        ShiftSwapRequest[]            @relation("SwapRequester")
  shiftSwapsAsCounterpart    ShiftSwapRequest[]            @relation("SwapCounterpart")
  changeRequests             EmployeeChangeRequest[]
  offboardingCases           OffboardingCase[]
  offerLetters               OfferLetter[]

  @@index([lifecycleStage, status])
  @@map("employees")
}

model ShiftDefinition {
  shiftId      String                    @id @default(cuid()) @map("shift_id")
  name         String                    @unique
  code         String                    @unique
  shiftType    ShiftType                 @default(DAY) @map("shift_type")
  startMinutes Int                       @map("start_minutes")
  endMinutes   Int                       @map("end_minutes")
  active       Boolean                   @default(true)
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  assignments  EmployeeShiftAssignment[]

  @@map("shift_definitions")
}

model EmployeeShiftAssignment {
  assignmentId  String          @id @default(cuid()) @map("assignment_id")
  employeeId    String          @map("employee_id")
  employee      Employee        @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  shiftId       String          @map("shift_id")
  shift         ShiftDefinition @relation(fields: [shiftId], references: [shiftId], onDelete: Restrict)
  effectiveFrom DateTime        @map("effective_from") @db.Date
  effectiveTo   DateTime?       @map("effective_to") @db.Date
  assignedBy    String?         @map("assigned_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([employeeId, effectiveFrom])
  @@index([shiftId])
  @@map("employee_shift_assignments")
}

model Department {
  departmentId       String                     @id @default(cuid()) @map("department_id")
  name               String
  /// Primary / first head (kept in sync with department_head_assignments for legacy lookups).
  headEmployeeId     String?                    @map("head_employee_id")
  headEmployee       Employee?                  @relation("DepartmentHead", fields: [headEmployeeId], references: [employeeId])
  headAssignments    DepartmentHeadAssignment[]
  parentDepartmentId String?                    @map("parent_department_id")
  parentDepartment   Department?                @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [departmentId])
  childDepartments   Department[]               @relation("DepartmentHierarchy")
  unitType           String                     @default("TEAM") @map("unit_type") @db.VarChar(20)
  sortOrder          Int                        @default(0) @map("sort_order")
  /// When false, people in this unit skip face enrollment and check-in camera.
  /// Global Face Security pause still wins for the whole org.
  faceVerificationEnabled Boolean                @default(true) @map("face_verification_enabled")
  employees          Employee[]
  taskBoardAccess    TaskBoardDepartment[]

  @@index([parentDepartmentId])
  @@index([name])
  @@map("departments")
}

/**
 * Multiple organization heads per unit (same person may also head several units).
 */
model DepartmentHeadAssignment {
  id           String     @id @default(cuid())
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [departmentId], onDelete: Cascade)
  employeeId   String     @map("employee_id")
  employee     Employee   @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([departmentId, employeeId])
  @@index([employeeId])
  @@map("department_head_assignments")
}

model Branch {
  branchId               String                   @id @default(cuid()) @map("branch_id")
  branchName             String                   @map("branch_name")
  branchCode             String                   @unique @map("branch_code")
  address                String
  city                   String?
  status                 String                   @default("ACTIVE")
  latitude               Decimal?                 @db.Decimal(10, 7)
  longitude              Decimal?                 @db.Decimal(10, 7)
  attendanceRadiusMeters Int                      @default(250) @map("attendance_radius_meters")
  isHub                  Boolean                  @default(false) @map("is_hub")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  devices                BiometricDevice[]
  employees              Employee[]
  schedules              EmployeeBranchSchedule[]
  events                 AttendanceEvent[]
  assets                 CompanyAsset[]

  @@map("branches")
}

model CompanyAsset {
  assetId                String               @id @default(cuid()) @map("asset_id")
  assetCode              String               @unique @map("asset_code")
  name                   String
  category               String
  catalogId              String?              @map("catalog_id")
  catalog                AssetCatalogItem?    @relation(fields: [catalogId], references: [catalogId])
  serialNumber           String?              @unique @map("serial_number")
  purchaseValue          Decimal              @map("purchase_value") @db.Decimal(12, 2)
  purchaseDate           DateTime?            @map("purchase_date") @db.Date
  assetType              AssetType            @default(PHYSICAL) @map("asset_type")
  assignmentScope        AssetAssignmentScope @default(EMPLOYEE) @map("assignment_scope")
  costFrequency          AssetCostFrequency   @default(ONE_TIME) @map("cost_frequency")
  renewalDate            DateTime?            @map("renewal_date") @db.Date
  status                 String               @default("AVAILABLE")
  assignedEmployeeId     String?              @map("assigned_employee_id")
  assignedEmployee       Employee?            @relation(fields: [assignedEmployeeId], references: [employeeId])
  branchId               String?              @map("branch_id")
  branch                 Branch?              @relation(fields: [branchId], references: [branchId])
  location               String?
  notes                  String?              @db.VarChar(1000)
  /// Laptop inventory details (shown when asset name is a laptop).
  laptopName             String?              @map("laptop_name")
  deviceId               String?              @map("device_id")
  productId              String?              @map("product_id")
  processor              String?
  ram                    String?
  ssd                    String?
  windowsVersion         String?              @map("windows_version")
  macAddress             String?              @map("mac_address")
  userPasswordEncrypted  String?              @map("user_password_encrypted") @db.Text
  adminPasswordEncrypted String?              @map("admin_password_encrypted") @db.Text
  warrantyUntil          DateTime?            @map("warranty_until") @db.Date
  assignments            AssetAssignment[]
  returns                AssetReturn[]
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  @@index([assignedEmployeeId])
  @@index([catalogId])
  @@index([status])
  @@index([assetType, costFrequency])
  @@index([assignmentScope, status])
  @@map("company_assets")
}

/// Active and historical employee seats/assignments for investment + visibility.
model AssetAssignment {
  assignmentId       String             @id @default(cuid()) @map("assignment_id")
  assetId            String             @map("asset_id")
  asset              CompanyAsset       @relation(fields: [assetId], references: [assetId], onDelete: Cascade)
  employeeId         String             @map("employee_id")
  employee           Employee           @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  visibleToEmployee  Boolean            @default(true) @map("visible_to_employee")
  assignedAt         DateTime           @default(now()) @map("assigned_at")
  returnedAt         DateTime?          @map("returned_at")
  /// Equal share of the asset pool cost locked for this seat (recalculated for active seats when seat count changes).
  costShareAmount    Decimal            @map("cost_share_amount") @db.Decimal(12, 2)
  costShareFrequency AssetCostFrequency @map("cost_share_frequency")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([assetId, returnedAt], map: "asset_asgn_asset_ret_idx")
  @@index([employeeId, returnedAt], map: "asset_asgn_emp_ret_idx")
  @@index([employeeId, visibleToEmployee, returnedAt], map: "asset_asgn_emp_vis_ret_idx")
  @@map("asset_assignments")
}

model AssetReturn {
  returnId            String       @id @default(cuid()) @map("return_id")
  assetId             String       @map("asset_id")
  asset               CompanyAsset @relation(fields: [assetId], references: [assetId])
  employeeId          String       @map("employee_id")
  employee            Employee     @relation(fields: [employeeId], references: [employeeId])
  receivedByUserId    String       @map("received_by_user_id")
  condition           String
  accessoriesReturned Boolean      @default(false) @map("accessories_returned")
  chargerReturned     Boolean      @default(false) @map("charger_returned")
  dataBackedUp        Boolean      @default(false) @map("data_backed_up")
  dataWiped           Boolean      @default(false) @map("data_wiped")
  physicalDamage      Boolean      @default(false) @map("physical_damage")
  damageNotes         String?      @map("damage_notes") @db.Text
  remarks             String?      @db.Text
  returnedAt          DateTime     @default(now()) @map("returned_at")

  @@index([assetId, returnedAt])
  @@index([employeeId, returnedAt])
  @@map("asset_returns")
}

model ExpenseClaim {
  claimId                String    @id @default(cuid()) @map("claim_id")
  employeeId             String    @map("employee_id")
  employee               Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  claimType              String    @default("EXPENSE") @map("claim_type")
  title                  String?
  category               String?
  amount                 Decimal   @db.Decimal(12, 2)
  expenseDate            DateTime? @map("expense_date") @db.Date
  description            String?   @db.Text
  remark                 String?   @db.Text
  claimMeta              Json?     @map("claim_meta")
  receiptUrl             String?   @map("receipt_url") @db.Text
  receiptAccessConfirmed Boolean   @default(false) @map("receipt_access_confirmed")
  status                 String    @default("PENDING")
  reviewedByUserId       String?   @map("reviewed_by_user_id")
