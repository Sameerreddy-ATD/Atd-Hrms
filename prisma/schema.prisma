  status               ApprovalStatus @default(PENDING)
  approverId           String?        @map("approver_id")
  reviewedBy           String?        @map("reviewed_by")
  decisionNote         String?        @map("decision_note") @db.Text
  employeeWindowEndsAt DateTime?      @map("employee_window_ends_at")
  isHrOnly             Boolean        @default(false) @map("is_hr_only")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@index([employeeId, createdAt])
  @@index([approverId, status, createdAt])
  @@index([status, createdAt])
  @@map("attendance_correction_requests")
}

model SystemSetting {
  key         String   @id
  value       String   @db.Text
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model IntegrationClient {
  clientId        String                   @id @default(cuid()) @map("client_id")
  name            String
  keyPrefix       String                   @unique @map("key_prefix") @db.VarChar(24)
  secretHash      String                   @unique @map("secret_hash") @db.VarChar(64)
  scopes          Json
  status          IntegrationClientStatus  @default(ACTIVE)
  expiresAt       DateTime?                @map("expires_at")
  lastUsedAt      DateTime?                @map("last_used_at")
  revokedAt       DateTime?                @map("revoked_at")
  createdByUserId String                   @map("created_by_user_id")
  createdBy       User                     @relation("IntegrationClientCreator", fields: [createdByUserId], references: [id])
  idempotencyKeys IntegrationIdempotency[]
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([status, expiresAt])
  @@map("integration_clients")
}

model IntegrationIdempotency {
  idempotencyId String            @id @default(cuid()) @map("idempotency_id")
  clientId      String            @map("client_id")
  client        IntegrationClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  key           String            @db.VarChar(200)
  requestHash   String            @map("request_hash") @db.VarChar(64)
  responseCode  Int               @map("response_code")
  responseBody  Json              @map("response_body")
  createdAt     DateTime          @default(now()) @map("created_at")
  expiresAt     DateTime          @map("expires_at")

  @@unique([clientId, key])
  @@index([expiresAt])
  @@map("integration_idempotency")
}

model EmployeeChangeEvent {
  sequence   BigInt             @id @default(autoincrement())
  eventId    String             @unique @default(cuid()) @map("event_id")
  employeeId String?            @map("employee_id")
  employee   Employee?          @relation(fields: [employeeId], references: [employeeId], onDelete: SetNull)
  eventType  EmployeeChangeType @map("event_type")
  version    Int
  payload    Json
  occurredAt DateTime           @default(now()) @map("occurred_at")

  @@index([employeeId, sequence])
  @@index([occurredAt])
  @@map("employee_change_events")
}

model NotificationPreference {
  preferenceId String   @id @default(cuid()) @map("preference_id")
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  digestMode   String   @default("immediate") @map("digest_mode")
  categories   Json     @default("{}")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("notification_preferences")
}

model RosterAssignment {
  assignmentId String   @id @default(cuid()) @map("assignment_id")
  employeeId   String   @map("employee_id")
  employee     Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  workDate     DateTime @map("work_date") @db.Date
  shiftPreset  String   @default("DAY") @map("shift_preset")
  startMinutes Int?     @map("start_minutes")
  endMinutes   Int?     @map("end_minutes")
  note         String?  @db.Text
  published    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, workDate])
  @@index([workDate, published])
  @@map("roster_assignments")
}

model OvertimeClaim {
  claimId          String    @id @default(cuid()) @map("claim_id")
  employeeId       String    @map("employee_id")
  employee         Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  workDate         DateTime  @map("work_date") @db.Date
  minutes          Int
  reason           String    @db.Text
  status           String    @default("PENDING")
  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedBy       User?     @relation("OvertimeReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNotes      String?   @map("review_notes") @db.Text
  reviewedAt       DateTime? @map("reviewed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([employeeId, workDate])
  @@index([status, createdAt])
  @@map("overtime_claims")
}

model ChecklistTemplate {
  templateId String                  @id @default(cuid()) @map("template_id")
  name       String
  kind       String
  isActive   Boolean                 @default(true) @map("is_active")
  items      ChecklistTemplateItem[]
  instances  ChecklistInstance[]
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  @@index([kind, isActive])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  itemId     String            @id @default(cuid()) @map("item_id")
  templateId String            @map("template_id")
  template   ChecklistTemplate @relation(fields: [templateId], references: [templateId], onDelete: Cascade)
  title      String
  linkPath   String?           @map("link_path")
  sortOrder  Int               @default(0) @map("sort_order")

  @@index([templateId, sortOrder])
  @@map("checklist_template_items")
}

model ChecklistInstance {
  instanceId String               @id @default(cuid()) @map("instance_id")
  templateId String               @map("template_id")
  template   ChecklistTemplate    @relation(fields: [templateId], references: [templateId])
  employeeId String               @map("employee_id")
  employee   Employee             @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  kind       String
  status     String               @default("OPEN")
  items      ChecklistItemState[]
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  @@index([employeeId, kind, status])
  @@map("checklist_instances")
}

model ChecklistItemState {
  stateId    String            @id @default(cuid()) @map("state_id")
  instanceId String            @map("instance_id")
  instance   ChecklistInstance @relation(fields: [instanceId], references: [instanceId], onDelete: Cascade)
  title      String
  linkPath   String?           @map("link_path")
  sortOrder  Int               @default(0) @map("sort_order")
  completed  Boolean           @default(false)
  completedAt DateTime?        @map("completed_at")

  @@index([instanceId, sortOrder])
  @@map("checklist_item_states")
}

model CompanyDocument {
  documentId     String        @id @default(cuid()) @map("document_id")
  title          String
  category       String        @default("POLICY")
  body           String?       @db.Text
  fileName       String?       @map("file_name")
  mimeType       String?       @map("mime_type")
  storageKey     String?       @map("storage_key")
  version        Int           @default(1)
  requiresAck    Boolean       @default(true) @map("requires_ack")
  visibilityRoles Json         @default("[]") @map("visibility_roles")
  published      Boolean       @default(true)
  uploadedById   String        @map("uploaded_by_id")
  uploadedBy     User          @relation("DocumentUploader", fields: [uploadedById], references: [id])
  acks           DocumentAck[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([published, category])
  @@map("company_documents")
}

model DocumentAck {
  ackId      String          @id @default(cuid()) @map("ack_id")
  documentId String          @map("document_id")
  document   CompanyDocument @relation(fields: [documentId], references: [documentId], onDelete: Cascade)
  employeeId String          @map("employee_id")
  employee   Employee        @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  version    Int
  acknowledgedAt DateTime    @default(now()) @map("acknowledged_at")

  @@unique([documentId, employeeId, version])
  @@index([employeeId])
  @@map("document_acks")
}

model AppraisalCycle {
  cycleId     String            @id @default(cuid()) @map("cycle_id")
  name        String
  startsOn    DateTime          @map("starts_on") @db.Date
  endsOn      DateTime          @map("ends_on") @db.Date
  status      String            @default("OPEN")
  reviews     AppraisalReview[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([status, startsOn])
  @@map("appraisal_cycles")
}

model AppraisalReview {
  reviewId         String         @id @default(cuid()) @map("review_id")
  cycleId          String         @map("cycle_id")
  cycle            AppraisalCycle @relation(fields: [cycleId], references: [cycleId], onDelete: Cascade)
  employeeId       String         @map("employee_id")
  employee         Employee       @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  managerUserId    String         @map("manager_user_id")
  manager          User           @relation("AppraisalManager", fields: [managerUserId], references: [id])
  rating           Int?
  comments         String?        @db.Text
  status           String         @default("DRAFT")
  submittedAt      DateTime?      @map("submitted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([cycleId, employeeId])
  @@index([managerUserId, status])
  @@map("appraisal_reviews")
}

model SopArticle {
  articleId     String    @id @default(cuid()) @map("article_id")
  title         String
  body          String    @db.Text
  audienceRoles Json      @default("[]") @map("audience_roles")
  published     Boolean   @default(false)
  authorUserId  String    @map("author_user_id")
  author        User      @relation("SopAuthor", fields: [authorUserId], references: [id])
  reads         SopRead[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([published, updatedAt])
  @@map("sop_articles")
}

model SopRead {
  readId     String     @id @default(cuid()) @map("read_id")
  articleId  String     @map("article_id")
  article    SopArticle @relation(fields: [articleId], references: [articleId], onDelete: Cascade)
  employeeId String     @map("employee_id")
  employee   Employee   @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  readAt     DateTime   @default(now()) @map("read_at")

  @@unique([articleId, employeeId])
  @@map("sop_reads")
}

model RecruitmentJob {
  jobId           String     @id @default(cuid()) @map("job_id")
  title           String
  departmentName  String?    @map("department_name")
  description     String?    @db.Text
  status          String     @default("OPEN")
  createdByUserId String     @map("created_by_user_id")
  createdBy       User       @relation("JobCreator", fields: [createdByUserId], references: [id])
  candidates      Candidate[]
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("recruitment_jobs")
}

model Candidate {
  candidateId       String         @id @default(cuid()) @map("candidate_id")
  jobId             String         @map("job_id")
  job               RecruitmentJob @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  name              String
  email             String?
  phone             String?
  stage             String         @default("APPLIED")
  notes             String?        @db.Text
  hiredEmployeeId   String?        @map("hired_employee_id")
  hiredEmployee     Employee?      @relation("HiredEmployee", fields: [hiredEmployeeId], references: [employeeId], onDelete: SetNull)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([jobId, stage])
  @@map("candidates")
}
