generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  DEVELOPER_ADMIN
  MAIN_ADMIN
  CEO
  HR
  MANAGER
  EMPLOYEE
  SALES
  DRIVER
  FIELD_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum AttendanceMode {
  THUMB_ONLY
  MOBILE_GPS_ONLY
  BOTH
}

enum Gender {
  FEMALE
  MALE
  PREFER_NOT_TO_SAY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
}

enum CompanyEntity {
  ROYAL_PETRO_PARK_PRIVATE_LIMITED
  ANYTIME_DIESEL
  FUELISTIC_INNOVATIONS_PRIVATE_LIMITED
}

enum BankAccountType {
  SAVINGS
  CURRENT
  SALARY
  NRE
  NRO
  OTHER
}

enum ShiftType {
  DAY
  NIGHT
}

/// Sunday is always the week off, or the employee picks a day each week (approval rules apply).
enum WeeklyOffPolicy {
  SUNDAY_FIXED
  SELECTABLE
}

enum AttendanceResult {
  FULL_DAY
  HALF_DAY
  ABSENT
  HOLIDAY
  WEEKLY_OFF
  PAID_LEAVE
  UNPAID_LEAVE
  PENDING
}

enum AttendanceLocationSource {
  BRANCH_MOBILE
  MOBILE
  THUMB_SCANNER
  MANUAL
  SYSTEM
}

enum LeaveSession {
  FULL
  FIRST_HALF
  SECOND_HALF
}

enum LeaveLedgerEntryType {
  ACCRUAL
  USAGE
  ADJUSTMENT
  CARRY_FORWARD
  EXPIRY
  REVERSAL
  REVOKE
}

enum WorkType {
  BRANCH
  FIELD
  CLIENT_VISIT
  WORK_FROM_HOME
  LEAVE
  HOLIDAY
}

enum EventSource {
  THUMB_SCANNER
  MOBILE_GPS
  MANUAL_CORRECTION
  LEAVE
  HOLIDAY
  SYSTEM
}

enum EventType {
  OFFICE_IN
  OFFICE_OUT
  BRANCH_IN
  BRANCH_OUT
  FIELD_CHECK_IN
  FIELD_CHECK_OUT
  CLIENT_CHECK_IN
  CLIENT_CHECK_OUT
