{
  "name": "anytime-diesel-employee-management",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "face:models": "node scripts/copy-face-models.mjs",
    "predev": "npm run face:models",
    "dev": "vite dev",
    "dev:backend": "tsx watch server/src/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "dev:with-db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "start:backend": "node dist-server/server/src/index.js",
    "prestart:frontend": "npm run face:models",
    "start:frontend": "vite preview --host 0.0.0.0",
    "check:i18n": "tsx scripts/check-i18n-keys.ts",
    "prebuild": "npm run face:models && npm run check:i18n",
    "build": "vite build",
    "build:backend": "tsc -p server/tsconfig.json",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:employee-api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-employee-api.ps1",
    "test:data-reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-reset-test-data.ps1",
    "test:tasks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-tasks.ps1",
    "test:local-ui:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-ui-test.ps1",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:start-mysql": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mysql.ps1",
    "db:verify": "node scripts/verify-mysql.mjs",
    "db:audit": "node scripts/audit-database.mjs",
    "repo:audit": "node scripts/audit-repository.mjs",
    "audit:deps": "npm audit --omit=dev",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "mobile:sync": "npx cap sync",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:copy": "npx cap copy",
    "mobile:android:bundle": "bash scripts/mobile-android-bundle.sh",
    "mobile:ios:open": "npx cap open ios",
    "mobile:icons": "python3 scripts/generate-android-icons.py"
  },
