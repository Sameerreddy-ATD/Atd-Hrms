<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode native bars so the pre-JS window (cold start / resume) already matches
         the dark UI instead of flashing the light #F6F8FC band. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#1a1f2a</item>
        <item name="android:statusBarColor">#1a1f2a</item>
        <item name="android:navigationBarColor">#1a1f2a</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
