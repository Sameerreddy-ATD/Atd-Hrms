<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+ supports dark icons on a light navigation bar. Older devices keep the
         dark (#000000) nav bar from the base theme so their white icons stay visible. -->
    <style name="AppTheme.NoActionBar">
        <item name="android:navigationBarColor">#F6F8FC</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
