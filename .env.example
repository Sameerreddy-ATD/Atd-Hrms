# MySQL connection used by Prisma and the Express backend. In production, use a dedicated
# least-privilege application user; root is only acceptable for isolated local bootstrap.
DATABASE_URL="mysql://atd_hrms:YOUR_PASSWORD@127.0.0.1:3306/anytimediesel_hrms"

# Optional: used only by scripts/start-mysql.ps1 when the root password differs.
MYSQL_ROOT_PASSWORD="YOUR_PASSWORD"
# Required only when scripts/start-mysql.ps1 initializes and seeds a fresh local database.
SEED_PASSWORD="replace-with-a-strong-initial-developer-admin-password"

BACKEND_PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
# Frontend API target compiled by Vite. Production normally uses https://your-domain/api.
VITE_API_BASE_URL="http://localhost:4000"
# Comma-separated hostnames accepted by the production Vite preview server.
# Set this to the deployment hostname(s), without scheme or path.
VITE_ALLOWED_HOSTS="localhost,127.0.0.1"
# Number of trusted reverse-proxy hops. Use 1 for one Nginx/ALB proxy.
# Keep "loopback" when only a same-server Nginx proxy connects to Express.
TRUST_PROXY="loopback"
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret"
# Stable 32+ character secret used to encrypt bank account, PAN, Aadhaar, and UAN values.
# Never rotate this without first re-encrypting the stored employee data.
EMPLOYEE_DATA_ENCRYPTION_KEY="replace-with-a-stable-employee-data-encryption-secret"
# Private directory for encrypted face-registration and attendance evidence.
# On Linux, use a persistent path outside the Git checkout.
FACE_EVIDENCE_DIR=".face-evidence"
SESSION_COOKIE_NAME="adh_session"
REFRESH_COOKIE_NAME="adh_refresh"
COOKIE_SECURE=false
NODE_ENV=development

# Sized for normal traffic from 200+ employees sharing an office/public IP.
# Sign-in attempts remain protected by the separate authentication limiter.
GENERAL_RATE_LIMIT_MAX=12000
GENERAL_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=50
AUTH_RATE_LIMIT_WINDOW_MS=900000
REQUEST_TIMEOUT_MS=30000
# Frontend request timeout compiled into the browser build.
VITE_API_TIMEOUT_MS=20000

# Web Push for installed Android/iPhone PWAs. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hrms@example.com"

# Native store push (Capacitor). Optional until Play/App Store push is enabled.
# Android: Firebase Cloud Messaging legacy server key (or migrate later to HTTP v1).
FCM_SERVER_KEY=""
# iOS: AuthKey_XXXX.p8 contents (PEM), Key ID, Team ID, and bundle id.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="com.anytimediesel.workforce"
APNS_KEY_P8=""
# Set to "false" to use the APNs sandbox host during TestFlight/dev.
APNS_PRODUCTION="true"
